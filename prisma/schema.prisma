datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum PostType {
  POST
  PRODUCT
}

enum TaskType {
  LINK
  NOTE
}

enum WebsiteType {
  NEWS
  PRODUCT
  GENERAL
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  department      String?
  image           String?
  openRouterApiKey String?
  aiEnabled       Boolean       @default(false)
  dailyCap        Int           @default(5)
  password        String
  role            Role          @default(EMPLOYEE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  websites       UserWebsite[]
  assignedTasks  Task[]        @relation("AssignedTasks")
  completedTasks Task[]        @relation("CompletedTasks")
  rejectedTasks  Task[]        @relation("RejectedTasks")
  notifications  Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Website {
  id          String      @id @default(cuid())
  name        String
  url         String?     @unique
  type        WebsiteType
  categories  Category[]
  users       UserWebsite[]
  tasks       Task[]
  createdAt   DateTime    @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  websiteId String
  website   Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime  @default(now())

  @@unique([websiteId, name])
}

model UserWebsite {
  id        String  @id @default(cuid())
  userId    String
  websiteId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([userId, websiteId])
}

model Task {
  id            String     @id @default(cuid())
  title         String?
  taskType      TaskType   @default(LINK)
  sourceLink    String?
  postType      PostType?
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id])
  websiteId     String?
  website       Website?   @relation(fields: [websiteId], references: [id])
  status        TaskStatus @default(PENDING)
  assignedToId  String?
  assignedTo    User?      @relation("AssignedTasks", fields: [assignedToId], references: [id])
  completedById String?
  completedBy   User?      @relation("CompletedTasks", fields: [completedById], references: [id])
  rejectedById  String?
  rejectedBy    User?      @relation("RejectedTasks", fields: [rejectedById], references: [id])
  rejectedAt    DateTime?
  rejectionReason String?
  mainCategory  String?
  subCategories String?
  publishedUrl  String?
  notes         String?
  isManual      Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
