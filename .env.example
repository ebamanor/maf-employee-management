# PostgreSQL connection (Render, Neon, Supabase, Vercel Postgres, etc.)
# Make sure it uses a pooled/server connection string if the provider offers one.
# Add ?sslmode=require for Render, Neon, Supabase, and most managed Postgres hosts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# Optional unpooled/direct connection. Vercel + Neon sets this automatically.
# start.sh uses it for `prisma db push` so migrations don't go through the pooler.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# Secret used for JWT/session signing in auth.ts and proxy.ts
AUTH_SECRET=change-this-to-a-long-random-string

# First admin account created on first run
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
